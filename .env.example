# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / SQLite fallback for instant local dev)
DATABASE_URL=postgres://whatsapp_user:whatsapp_secret_password@localhost:5432/whatsapp_dashboard
# For local zero-dependency SQLite run:
SQLITE_DB_PATH=./data/whatsapp.sqlite

# Redis & Queue Configuration
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_for_security!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# n8n Automation Engine
N8N_WEBHOOK_URL=http://localhost:5678/webhook/whatsapp-campaign-dispatch
N8N_CALLBACK_SECRET=whatsapp_dashboard_n8n_secret_key

# Meta WhatsApp Webhook Verification
META_VERIFY_TOKEN=whatsapp_meta_verify_token_123

# Frontend URL
FRONTEND_URL=http://localhost:3000
