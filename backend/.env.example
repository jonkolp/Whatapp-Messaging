# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Embedded SQLite with sql.js WASM)
SQLITE_DB_PATH=./data/whatsapp.sqlite

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_for_security!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OpenWA WhatsApp Engine (Local Docker Container)
OPENWA_GATEWAY_URL=http://localhost:2785
OPENWA_API_KEY=owa_k1_b6e2f42630ded3c45ea5438417bec7576b5b25e950e21ea145f4eb089e2076a7

# n8n Automation Engine (Optional / Native Fallback Active)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/whatsapp-campaign-dispatch
N8N_CALLBACK_SECRET=whatsapp_dashboard_n8n_secret_key

# Meta WhatsApp Webhook Verification
META_VERIFY_TOKEN=whatsapp_meta_verify_token_123

# Frontend URL
FRONTEND_URL=http://localhost:3000
